{
  "expo": {
    "name": "DevManager",
    "slug": "devmanager",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tague.devmanager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.tague.devmanager"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0b1020"
          }
        }
      ],
      "expo-font"
    ],
    "scheme": "devmanager",
    "description": "Gestion d’entreprise : projets, budgets, tâches et messagerie (application mobile de DevManager).",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64918ac5-29de-4ea9-9024-19eb56491ad2"
      }
    },
    "owner": "tague"
  }
}
