# Copier ce fichier en ".env" pour personnaliser docker compose
DB_PASSWORD=devmanager
# Cle secrete JWT : 32 caracteres minimum, a garder secrete
JWT_SECRET=remplacer-par-une-longue-cle-secrete-aleatoire

# Emails de reinitialisation (facultatif) : sans cle, le lien s'affiche dans les logs du backend
BREVO_API_KEY=
# Adresse d'expedition, verifiee dans Brevo (Senders & IP > Senders)
MAIL_SENDER_EMAIL=
